# Copy this file to `.env` and fill in the values below.

# Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here

# Command prefix used to invoke text commands (e.g. !play)
BOT_PREFIX=!

# Maximum number of tracks queued from a single !playlist URL
MAX_PLAYLIST_TRACKS=25

# --- Optional: log in to YouTube so yt-dlp can play age-restricted, 
# members-only, or otherwise sign-in-gated videos. See README.md for setup.
# Provide EITHER a cookies file OR a browser name, not both.

# Path to a Netscape-format cookies.txt file exported from your browser.
# COOKIES_FILE=cookies.txt

# Name of a browser installed on this machine to read cookies from directly
# (only works if the bot runs on the same machine you're logged into YouTube in).
# Format: BROWSER[+KEYRING][:PROFILE][::CONTAINER], e.g. chrome, firefox:Default
# COOKIES_FROM_BROWSER=chrome
